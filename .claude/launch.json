{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8010",
        "--reload",
        "--reload-dir",
        "backend/app"
      ],
      "port": 8010
    },
    {
      "name": "backend-sentetik-demo",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set SENTETIK_DEMO=1&& backend\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --port 8010"
      ],
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "frontend-5174",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}